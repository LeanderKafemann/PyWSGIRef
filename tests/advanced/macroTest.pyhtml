<{{evalPyHTML}}><title>Hello World</title>
		<{{evalPyHTML-modernStyling: true}}>
	</head>
	<body>
		<h1>Hello World</h1>
		<p>
		    You should now see the decoded macros:<br/>
			Time-macro: <{{evalPyHTML-macro: time :macro-}}><br/>
			Hello world bold macro: <{{evalPyHTML-macro: helloWorld :macro-}}>
			Another time the time: <{{evalPyHTML-macro: time :macro-}}>
		</p>
	</body>
</html>